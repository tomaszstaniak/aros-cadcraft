From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Fri, 13 Nov 2026 05:30:07 +0100
Subject: [PATCH] posixc: open() sets the calling thread's errno

__fdesc.c wrote errno through its own macro, the _errno field of the stdc base that the posixc base holds. Since errno is per thread (956444232f) the caller's errno is the one of the first stdc base its thread opened, which is usually the program's own base, so a failed open() left the caller's errno as it was: opening a missing file read as "No error", or as the error of an earlier call.

The macro is removed and __set_errno() uses errno from <errno.h>, as the rest of posixc does. The check for a posixc base without StdCBase stays: during library open errno cannot be reached.

Test: developer/debug/test/crt/posixc/open_errno.c (ENOENT for a missing file, EEXIST for O_CREAT|O_EXCL, on the main task and on a pthread).
---
 compiler/crt/posixc/__fdesc.c                 | 10 +--
 developer/debug/test/crt/posixc/mmakefile.src | 10 ++-
 developer/debug/test/crt/posixc/open_errno.c  | 78 +++++++++++++++++++
 3 files changed, 91 insertions(+), 7 deletions(-)
 create mode 100644 developer/debug/test/crt/posixc/open_errno.c

diff --git a/compiler/crt/posixc/__fdesc.c b/compiler/crt/posixc/__fdesc.c
index 25243db383..bd53e345e8 100644
--- a/compiler/crt/posixc/__fdesc.c
+++ b/compiler/crt/posixc/__fdesc.c
@@ -28,11 +28,6 @@
 #include "__dos64.h"
 #include "__upath.h"
 
-#ifdef errno
-#undef errno
-#endif
-#define errno (*(&((struct PosixCBase *)PosixCBase)->StdCBase->_errno))
-
 static int __fdlib_available(struct PosixCIntBase *PosixCBase)
 {
     if (PosixCBase->PosixCFDBase == NULL)
@@ -41,6 +36,11 @@ static int __fdlib_available(struct PosixCIntBase *PosixCBase)
     return PosixCBase->PosixCFDBase != NULL;
 }
 
+/*
+    errno is the calling thread's (__stdc_geterrnoptr()), which need not be
+    the errno of the stdc base this posixc base holds. While the library is
+    being opened StdCBase is not set yet and errno cannot be reached.
+*/
 static void __set_errno(struct PosixCIntBase *PosixCBase, int enval)
 {
     if (((struct PosixCBase *)PosixCBase)->StdCBase) {
diff --git a/developer/debug/test/crt/posixc/mmakefile.src b/developer/debug/test/crt/posixc/mmakefile.src
index 22d6baab1a..75d8a51b95 100644
--- a/developer/debug/test/crt/posixc/mmakefile.src
+++ b/developer/debug/test/crt/posixc/mmakefile.src
@@ -70,8 +70,8 @@ CUNITEXEDIR := $(AROS_TESTS)/cunit/crt/posixc
 #MM- test-cunit : test-crt-posixc-cunit
 #MM- test-cunit-quick : test-crt-posixc-cunit-quick
 
-#MM- test-crt-posixc : test-crt-posixc-general test-crt-posixc-gnu test-crt-posixc-mempool test-crt-posixc-remove-errno test-crt-posixc-pipe-no-reader test-crt-posixc-2k8 test-crt-posixc-nix test-crt-posixc-posix1 test-crt-posixc-$(TARGET_UNITTESTS)-cunit
-#MM- test-crt-posixc-quick : test-crt-posixc-general-quick test-crt-posixc-gnu-quick test-crt-posixc-mempool-quick test-crt-posixc-remove-errno-quick test-crt-posixc-pipe-no-reader-quick test-crt-posixc-2k8-quick test-crt-posixc-nix-quick test-crt-posixc-posix1-quick test-crt-posixc-$(TARGET_UNITTESTS)-cunit-quick
+#MM- test-crt-posixc : test-crt-posixc-general test-crt-posixc-gnu test-crt-posixc-mempool test-crt-posixc-remove-errno test-crt-posixc-open-errno test-crt-posixc-pipe-no-reader test-crt-posixc-2k8 test-crt-posixc-nix test-crt-posixc-posix1 test-crt-posixc-$(TARGET_UNITTESTS)-cunit
+#MM- test-crt-posixc-quick : test-crt-posixc-general-quick test-crt-posixc-gnu-quick test-crt-posixc-mempool-quick test-crt-posixc-remove-errno-quick test-crt-posixc-open-errno-quick test-crt-posixc-pipe-no-reader-quick test-crt-posixc-2k8-quick test-crt-posixc-nix-quick test-crt-posixc-posix1-quick test-crt-posixc-$(TARGET_UNITTESTS)-cunit-quick
 
 #MM test-crt-posixc-general : includes includes-copy linklibs kernel
 #MM test-crt-posixc-2k8 : includes includes-copy linklibs kernel
@@ -170,6 +170,12 @@ USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/..
 %build_prog mmake=test-crt-posixc-remove-errno \
     progname=remove_errno files=remove_errno targetdir=$(EXEDIR) uselibs="pthread"
 
+#MM test-crt-posixc-open-errno : includes includes-copy linklibs kernel
+
+USER_INCLUDES := -I$(SRCDIR)/$(CURDIR)/..
+%build_prog mmake=test-crt-posixc-open-errno \
+    progname=open_errno files=open_errno targetdir=$(EXEDIR) uselibs="pthread"
+
 #MM- test-crt-posixc : test-crt-posixc-stdio-closed
 #MM test-crt-posixc-stdio-closed : includes linklibs
 
diff --git a/developer/debug/test/crt/posixc/open_errno.c b/developer/debug/test/crt/posixc/open_errno.c
new file mode 100644
index 0000000000..8475a4b2c3
--- /dev/null
+++ b/developer/debug/test/crt/posixc/open_errno.c
@@ -0,0 +1,78 @@
+/*
+    Copyright (C) 2026, The AROS Development Team. All rights reserved.
+*/
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <unistd.h>
+#include "test.h"
+
+#define PRESENT_PATH "T:open_errno_present"
+#define ABSENT_PATH "T:open_errno_absent"
+
+int created = 0;
+
+/* open() must fail and leave `expected` in the caller's errno, whatever an
+   earlier call left there */
+static int check(const char *path, int flags, int expected)
+{
+    int fd;
+
+    errno = EDOM;
+    fd = open(path, flags, 0644);
+    if (fd != -1)
+    {
+        close(fd);
+        return 0;
+    }
+    return errno == expected;
+}
+
+static int check_all(void)
+{
+    return check(ABSENT_PATH, O_RDONLY, ENOENT)
+        && check(ABSENT_PATH, O_WRONLY, ENOENT)
+        && check(PRESENT_PATH, O_CREAT | O_EXCL | O_WRONLY, EEXIST);
+}
+
+static void *worker(void *result)
+{
+    *(int *)result = check_all();
+    return NULL;
+}
+
+int main(void)
+{
+    pthread_t thread;
+    int worker_result = 0;
+    int fd;
+
+    unlink(ABSENT_PATH);
+    fd = open(PRESENT_PATH, O_CREAT | O_WRONLY | O_TRUNC, 0644);
+    TEST((fd != -1));
+    created = 1;
+    TEST((close(fd) == 0));
+
+    TEST((check(ABSENT_PATH, O_RDONLY, ENOENT)));
+    TEST((check(ABSENT_PATH, O_WRONLY, ENOENT)));
+    TEST((check(PRESENT_PATH, O_CREAT | O_EXCL | O_WRONLY, EEXIST)));
+
+    /* The result must reach the task that made the call */
+    TEST((pthread_create(&thread, NULL, worker, &worker_result) == 0));
+    TEST((pthread_join(thread, NULL) == 0));
+    TEST((worker_result));
+
+    cleanup();
+    return OK;
+}
+
+void cleanup(void)
+{
+    if (created)
+    {
+        created = 0;
+        unlink(PRESENT_PATH);
+    }
+}
