From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tomaszstaniak <68373859+tomaszstaniak@users.noreply.github.com>
Date: Fri, 13 Nov 2026 01:47:08 +0100
Subject: [PATCH] cadcraft-cli: own stack on AROS, DWG in the same process, the
 thread pool ended at exit

An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One Shell, and whatever an MCP client's process creation gives. Parsing and rendering overrun that, and the overrun takes the system down with it. On target_os = "aros" the command runs on a thread with an 8 MiB stack and hands its exit code back to the main task. The DWG worker process is not started there: DWG files are converted in the calling process, as in a build without a worker. AROS's pthread library joins every thread at exit and rayon's idle global workers never end, so a conversion to DWG did not return on ABIv11; the pool is ended before the exit (rayon-core patched by the port). Other systems are unchanged.
---
 apps/cadcraft-cli/Cargo.toml  |  5 ++++
 apps/cadcraft-cli/src/main.rs | 43 ++++++++++++++++++++++++++++++-----
 2 files changed, 42 insertions(+), 6 deletions(-)

diff --git a/apps/cadcraft-cli/Cargo.toml b/apps/cadcraft-cli/Cargo.toml
index cac076c17282e27fe25993d568f09ccde1dc9a5f..7573baf3cf2d876d24b516f1b8cccf631fbb47f4 100644
--- a/apps/cadcraft-cli/Cargo.toml
+++ b/apps/cadcraft-cli/Cargo.toml
@@ -27,6 +27,11 @@ same-file = { workspace = true }
 serde_json = { workspace = true }
 thiserror = { workspace = true }
 
+# The patched rayon-core (see the AROS port's crate patches) can end the global pool's threads,
+# which AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
+
 [dev-dependencies]
 # Shell completions and man pages (examples/man-and-completions.rs, for the Linux packages); not
 # in the binary.
diff --git a/apps/cadcraft-cli/src/main.rs b/apps/cadcraft-cli/src/main.rs
index 866923c9a09f61ea0cbc68ec577278dbd122f6ad..5fdbc83097ea3687eed5453ebefd91662e18ef83 100644
--- a/apps/cadcraft-cli/src/main.rs
+++ b/apps/cadcraft-cli/src/main.rs
@@ -1,13 +1,44 @@
 #![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
 
+/// The command thread's stack on AROS (see `main`).
+#[cfg(target_os = "aros")]
+const AROS_STACK: usize = 8 << 20;
+
 fn main() {
-    // A copy of this program started to read or write a DWG file does only that.
-    if let Some(code) = cadcraft_io::dwg_worker::serve_if_asked() {
-        std::process::exit(code);
+    #[cfg(not(target_os = "aros"))]
+    let code = cli_main();
+    // An AROS program runs on the stack of whatever starts it: 40,960 bytes in an AROS One
+    // Shell, and whatever an MCP client's process creation gives. Parsing and rendering overrun
+    // that, and the overrun takes the system down with it. The command runs on a thread with its
+    // own stack, so no caller has to know the size; the exit code comes back to the main task,
+    // because ending the process from another thread crashes on AROS.
+    #[cfg(target_os = "aros")]
+    let code = std::thread::Builder::new()
+        .name("cadcraft-cli".into())
+        .stack_size(AROS_STACK)
+        .spawn(cli_main)
+        .map_err(|e| eprintln!("cadcraft-cli: {e}"))
+        .and_then(|worker| worker.join().map_err(|_| eprintln!("cadcraft-cli: the command panicked")))
+        .unwrap_or(1);
+    // AROS's pthread library joins every thread in its exit handler; rayon's idle global
+    // workers (the DWG reader and writer run on them) never end by themselves, so a command
+    // that used them could not exit.
+    #[cfg(target_os = "aros")]
+    rayon_core::terminate_global_thread_pool();
+    std::process::exit(code);
+}
+
+fn cli_main() -> i32 {
+    // A copy of this program started to read or write a DWG file does only that. Not on AROS:
+    // DWG files are read and written in this process there (no child process with pipes).
+    #[cfg(not(target_os = "aros"))]
+    {
+        if let Some(code) = cadcraft_io::dwg_worker::serve_if_asked() {
+            return code;
+        }
+        cadcraft_io::dwg_worker::use_own_worker();
     }
-    cadcraft_io::dwg_worker::use_own_worker();
     // `args_os`, not `args`: a non-Unicode argument (a Latin-1 file name on Linux) must be
     // reported as an error, not panic before anything is printed.
-    let code = cadcraft_cli::run(std::env::args_os().skip(1), &mut std::io::stdout(), &mut std::io::stderr());
-    std::process::exit(code);
+    cadcraft_cli::run(std::env::args_os().skip(1), &mut std::io::stdout(), &mut std::io::stderr())
 }
