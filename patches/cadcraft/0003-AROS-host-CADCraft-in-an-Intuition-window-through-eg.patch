+[package]
+name = "cadcraft-aros"
+description = "CADCraft on AROS: the egui interface in an Intuition window, through egui-aros"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+publish = false
+
+# The window, input, renderers, requesters, clipboard, character set and start-up data come
+# from egui-aros (shared by the Craft AROS ports); this crate has no `unsafe` code of its own.
+[lints]
+workspace = true
+
+[[bin]]
+name = "CADCraft"
+path = "src/main.rs"
+
+[dependencies]
+cadcraft-engine = { workspace = true }
+cadcraft-ui-egui = { workspace = true }
+cadcraft-io = { workspace = true }
+egui = { workspace = true }
+# Built from a pinned egui-aros commit with its crate patches: see the port's scripts/craft.py.
+# OpenGL is compiled in and chosen at run time (CPU, AUTO or GPU).
+egui-aros = { version = "0.1", features = ["asl", "glow"] }
+# Its minimum_stack! macro (egui_aros::startup is the same crate).
+aros-startup = "0.1"
+serde_json = { workspace = true }
+log = { workspace = true }
+# --screenshot writes PNG.
+image = { workspace = true }
+
+# The patched rayon-core (see the AROS port's crate patches) can end the global pool's threads,
+# which AROS's pthread library otherwise waits for forever when the program exits.
+[target.'cfg(target_os = "aros")'.dependencies]
+rayon-core = "1.13"
diff --git a/apps/cadcraft-aros/src/main.rs b/apps/cadcraft-aros/src/main.rs
