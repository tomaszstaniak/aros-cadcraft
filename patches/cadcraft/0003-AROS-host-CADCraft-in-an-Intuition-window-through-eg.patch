index 0000000000000000000000000000000000000000..df9e021d4125e3110ffae1239714eceab8b7b6e4
--- /dev/null
+++ b/apps/cadcraft-aros/src/services.rs
@@ -0,0 +1,121 @@
+//! The platform services CADCraft uses on AROS: ASL file requesters. The same contract as the
+//! desktop app's `services` (apps/cadcraft/src/main.rs), without rfd, which has no AROS backend.
+//!
+//! Paths: the program runs in the -nix path mode; requesters speak DOS names, converted at this
+//! edge (egui_aros::startup).
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use cadcraft_ui_egui::Services;
+use egui_aros::WindowHandle;
+use egui_aros::asl::{Select, request};
+use egui_aros::startup::{dos_to_nix, nix_to_dos};
+
+/// The window the requesters are parented to, set once the window is open (the requester runs on
+/// the main thread, modally, while the loop is inside the service call). The handle holds the
+/// window weakly: after it closes, a requester opens without a parent.
+pub type SharedWindow = Rc<RefCell<Option<WindowHandle>>>;
+
+/// Drawings File > Open reads: the desktop app's filters, as an AmigaDOS pattern (matched without
+/// regard to case).
+const DRAWINGS: &str = "#?.(dwg|dxf|dwt|svg|svgz)";
+const LISP: &str = "#?.lsp";
+const PGP: &str = "#?.pgp";
+/// The types Save As offers; a name of another type (or none) becomes .dxf, as in the desktop app.
+const SAVE_TYPES: [&str; 6] = ["dxf", "dwg", "dwt", "svg", "png", "pdf"];
+
+/// The file name part of a path (`a.dxf` for `/Work/Plans/a.dxf`).
+pub fn file_part(path: &str) -> &str {
+    path.rsplit('/').next().unwrap_or(path)
+}
+
+/// The drawer part of a -nix path (`/Work/Plans` for `/Work/Plans/a.dxf`).
+pub fn dir_part(path: &str) -> &str {
+    match path.rfind('/') {
+        Some(0) | None => "",
+        Some(i) => path.get(..i).unwrap_or(""),
+    }
+}
+
+/// The name Save As suggests: the stem of `suggested` with its type when it is one of
+/// [`SAVE_TYPES`], otherwise `.dxf`.
+pub fn save_name(suggested: &str) -> String {
+    let name = file_part(suggested);
+    let (stem, ext) = match name.rsplit_once('.') {
+        Some((stem, ext)) if !stem.is_empty() => (stem, ext.to_ascii_lowercase()),
+        _ => (name, String::new()),
+    };
+    let stem = if stem.is_empty() { "Drawing1" } else { stem };
+    let ext = if SAVE_TYPES.contains(&ext.as_str()) { ext } else { "dxf".to_owned() };
+    format!("{stem}.{ext}")
+}
+
+/// One file from an ASL requester, as a -nix path; `dir` is the -nix drawer it opens in.
+fn pick(window: &SharedWindow, select: Select, title: &str, dir: &str, file: &str, pattern: &str) -> Option<String> {
+    let win = window.borrow().clone()?;
+    let start = if dir.is_empty() { String::new() } else { nix_to_dos(dir).unwrap_or_default() };
+    let dos = request(&win, select, title, &start, file, pattern).into_iter().next()?;
+    match dos_to_nix(&dos) {
+        Ok(p) => Some(p),
+        Err(e) => {
+            log::warn!("requester: {dos}: {e}");
+            None
+        }
+    }
+}
+
+/// The services for this host.
+pub fn aros(window: SharedWindow) -> Services {
+    let last_dir: Rc<RefCell<String>> = Rc::new(RefCell::new(String::new()));
+    let (open_window, save_window, lisp_window, pgp_window) = (window.clone(), window.clone(), window.clone(), window);
+    let (open_dir, save_dir) = (last_dir.clone(), last_dir);
+    Services {
+        pick_open: Some(Box::new(move || {
+            let dir = open_dir.borrow().clone();
+            let path = pick(&open_window, Select::Open, "Open", &dir, "", DRAWINGS)?;
+            *open_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        pick_save: Some(Box::new(move |suggested: &str| {
+            let dir = dir_part(suggested).to_string();
+            let dir = if dir.is_empty() { save_dir.borrow().clone() } else { dir };
+            let path = pick(&save_window, Select::Save, "Save As", &dir, &save_name(suggested), "")?;
+            *save_dir.borrow_mut() = dir_part(&path).to_string();
+            Some(path)
+        })),
+        // The requesters are modal on the main thread; no deferred picker.
+        start_pick: None,
+        pick_lisp: Some(Box::new(move |dir: &str| pick(&lisp_window, Select::Open, "Load AutoLISP File", dir, "", LISP))),
+        no_file_system: false,
+        pick_pgp: Some(Box::new(move |dir: Option<&str>| pick(&pgp_window, Select::Open, "Import Alias File", dir.unwrap_or_default(), "", PGP))),
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn path_parts() {
+        assert_eq!(file_part("/Work/Plans/a.dxf"), "a.dxf");
+        assert_eq!(dir_part("/Work/Plans/a.dxf"), "/Work/Plans");
+        assert_eq!(dir_part("/RAM"), "");
+        assert_eq!(dir_part("a.dxf"), "");
+    }
+
+    #[test]
+    fn save_keeps_known_types_and_defaults_to_dxf() {
+        assert_eq!(save_name("Drawing1"), "Drawing1.dxf");
+        assert_eq!(save_name("/RAM/Plan.DWG"), "Plan.dwg");
+        assert_eq!(save_name("Sheet.pdf"), "Sheet.pdf");
+        assert_eq!(save_name("Old.xyz"), "Old.dxf");
+        assert_eq!(save_name(""), "Drawing1.dxf");
+    }
+
+    #[test]
+    fn the_open_pattern_fits_the_requester() {
+        // asl.library copies the pattern into a 257-byte gadget without a length check.
+        assert!(DRAWINGS.len() <= 255);
+    }
+}
