.KEY RUNDIR/A,MACHINE/A
.BRA [
.KET ]
; CADCraft from the public apkg catalogue: update, show, install, verify, use, remove.
; Put apkg (for this system) and steps-pkg.json into RAM:t; the network must be up.
FailAt 21
Protect RAM:t/apkg +e
MakeDir RAM:pk
Date >[RUNDIR]/date.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] update >[RUNDIR]/update.txt
Echo $RC >[RUNDIR]/update.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] show cadcraft >[RUNDIR]/show.txt
Echo $RC >[RUNDIR]/show.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] install cadcraft --yes >[RUNDIR]/install.txt
Echo $RC >[RUNDIR]/install.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] verify cadcraft >[RUNDIR]/verify.txt
Echo $RC >[RUNDIR]/verify.rc
RAM:pk/CADCraft/cadcraft-cli --version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:pk/CADCraft/cadcraft-cli sample floorplan RAM:t/floorplan.dwg >[RUNDIR]/cli-sample.txt
Echo $RC >[RUNDIR]/cli-sample.rc
SetEnv RUST_LOG info
RAM:pk/CADCraft/CADCraft --window 780x540 --test-steps RAM:t/steps-pkg.json RAM:t/floorplan.dwg
Echo $RC >[RUNDIR]/gui.rc
Copy RAM:pk/CADCraft/CADCraftData/CADCraft.log [RUNDIR]/CADCraft.log
Copy RAM:pk/CADCraft/BUILD.txt [RUNDIR]/BUILD.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] remove cadcraft --yes >[RUNDIR]/remove.txt
Echo $RC >[RUNDIR]/remove.rc
Type [RUNDIR]/install.txt
Echo "done" >[RUNDIR]/public-done.txt
