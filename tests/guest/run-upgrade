.KEY RUNDIR/A,MACHINE/A
.BRA [
.KET ]
; Upgrade check with apkg from local indexes, everything under RAM:. Payload in RAM:t: apkg,
; old.zip + idx-old.json (the previous release), cc.zip + idx.json (the new package),
; steps-pkg.json, steps-pkg2.json. The previous release is installed and used once, then
; upgraded; the new program is verified, used twice and removed. old.log and CADCraft.log hold
; the frame costs of the same scripted session before and after.
; Execute RAM:t/run-upgrade <results directory> <machine name>
FailAt 21
Protect RAM:t/apkg +e
MakeDir RAM:pk
MakeDir RAM:pk/cache
Copy RAM:t/old.zip RAM:pk/cache/cadcraft.zip
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx-old.json install cadcraft --yes >[RUNDIR]/old-install.txt
Echo $RC >[RUNDIR]/old-install.rc
SetEnv RUST_LOG info
RAM:pk/CADCraft/CADCraft --window 780x540 --sample --test-steps RAM:t/steps-pkg.json
Echo $RC >[RUNDIR]/old-gui.rc
Copy RAM:pk/CADCraft/CADCraftData/CADCraft.log [RUNDIR]/old.log
Delete RAM:pk/CADCraft/CADCraftData/CADCraft.log QUIET
Echo "user file kept across the upgrade" >RAM:pk/CADCraft/CADCraftData/marker.txt
List RAM:pk/CADCraft ALL >[RUNDIR]/before-upgrade.txt
Copy RAM:t/cc.zip RAM:pk/cache/cadcraft.new.zip
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json outdated >[RUNDIR]/outdated.txt
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json upgrade cadcraft --yes >[RUNDIR]/upgrade.txt
Echo $RC >[RUNDIR]/upgrade.rc
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json verify cadcraft >[RUNDIR]/verify.txt
Echo $RC >[RUNDIR]/verify.rc
List RAM:pk/CADCraft ALL >[RUNDIR]/after-upgrade.txt
Type RAM:pk/CADCraft/CADCraftData/marker.txt >[RUNDIR]/marker.txt
RAM:pk/CADCraft/cadcraft-cli --version >[RUNDIR]/cli-version.txt
Echo $RC >[RUNDIR]/cli-version.rc
RAM:pk/CADCraft/CADCraft --version >[RUNDIR]/gui-version.txt
RAM:pk/CADCraft/CADCraft --window 780x540 --sample --test-steps RAM:t/steps-pkg.json
Echo $RC >[RUNDIR]/gui.rc
RAM:pk/CADCraft/cadcraft-cli info RAM:t/pkg-saved.dxf --compact >[RUNDIR]/saved-info.txt
Echo $RC >[RUNDIR]/saved-info.rc
RAM:pk/CADCraft/CADCraft --window 780x540 --test-steps RAM:t/steps-pkg2.json
Echo $RC >[RUNDIR]/gui2.rc
Copy RAM:pk/CADCraft/CADCraftData/CADCraft.log [RUNDIR]/CADCraft.log
Copy RAM:pk/CADCraft/BUILD.txt [RUNDIR]/BUILD.txt
Copy RAM:t/pkg-a.png [RUNDIR]/pkg-a.png
Copy RAM:t/pkg-b.png [RUNDIR]/pkg-b.png
RAM:t/apkg --root RAM:pk --machine [MACHINE] --index RAM:t/idx.json remove cadcraft --yes >[RUNDIR]/remove.txt
Echo $RC >[RUNDIR]/remove.rc
List RAM:pk ALL >[RUNDIR]/after-remove.txt
Echo "done" >[RUNDIR]/upgrade-done.txt
